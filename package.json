{
  "name": "cal-desktop",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "pnpm domain:build && vite --host 127.0.0.1",
    "build": "pnpm domain:build && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "node scripts/tool.mjs tauri",
    "desktop": "node scripts/tool.mjs tauri dev",
    "desktop:build": "node scripts/tool.mjs tauri build",
    "rust": "node scripts/tool.mjs cargo",
    "test": "pnpm domain:build && vitest run",
    "test:ui": "playwright test",
    "cli": "node scripts/tool.mjs cargo run --manifest-path src-tauri/Cargo.toml -p aika-cli --",
    "cli:build": "node scripts/tool.mjs cargo build --manifest-path src-tauri/Cargo.toml -p aika-cli --release",
    "types:generate": "node scripts/tool.mjs cargo run --manifest-path src-tauri/Cargo.toml --bin export-types",
    "desktop:test:build": "node scripts/tool.mjs tauri build --debug --no-bundle --features native-test",
    "test:native": "node scripts/tool.mjs cargo build --manifest-path src-tauri/Cargo.toml -p aika-cli && node scripts/native-test.mjs",
    "alpha:build": "node scripts/alpha.mjs",
    "test:google-config": "node scripts/google-config-smoke.mjs",
    "test:env": "node --test scripts/environment.test.mjs",
    "test:packaging": "node --test scripts/alpha.test.mjs scripts/release.test.mjs",
    "release:build": "node scripts/release.mjs build",
    "domain:build": "node scripts/domain-build.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@tauri-apps/api": "^2.9.0",
    "lucide-react": "^0.468.0",
    "luxon": "^3.7.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "webdriverio": "^10.0.2"
  }
}
